{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shike Alarm",
  "version": "0.1.1",
  "identifier": "io.github.yaohub.shike",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:8765",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "时刻 · 闹钟与倒计时",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "yao-Hub",
    "shortDescription": "闹钟与倒计时桌面应用",
    "longDescription": "支持多个闹钟、重复规则、倒计时、提示音选择，并可驻留托盘持续计时。",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
